[flake8]
# flake8 does not read pyproject.toml, which is why this file exists rather than a
# [tool.flake8] block: without it, `flake8 .` runs on stock defaults - 79-column lines
# against a 99-column black codebase, and no exclude, so it walks .venv too.
max-line-length = 99
exclude = .git,__pycache__,.venv,build,dist
# black owns line length and slice/operator whitespace.
extend-ignore = E203,E501,W503
# Any exemption is per file (`per-file-ignores`), never repository-wide, so a dead
# import fails loudly. None is needed today; a list added later is hand-maintained,
# which is safe in the direction that matters: forget to list a file and lint fails.
#
# telethon_secret_chat/schema/secret_tl.py is THE exempt file of this repository,
# and the constitution names it: "Generated schema files are exempt and MUST be
# marked as generated". It is about 2,800 lines of emitted constructors, `# generated` on
# line 1, rebuilt by `uv run --locked python tools/generate_schema.py` from the
# schema fetched verbatim into schema/end-to-end.tl. The exemption is from the
# 800-line ceiling, which is a constitution rule rather than a flake8 one - it is
# recorded here because this is where a reader comes to ask why a file is special.
# Its ninety `__init__` parameters shadow nothing and the file is black-clean, so
# no code is silenced for it.
# max-complexity is deliberately absent. Setting a limit that is already breached, or
# raising the limit until it fits, would both be theatre. Reducing complexity is
# separate, deliberate work.
